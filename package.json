{
  "name": "cyclon-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "data:build": "node scripts/prepare-storm-data.mjs && npm run data:index",
    "data:index": "node scripts/build-seo-index.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "^6.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@conychoi/eslint-config": "^1.0.0",
    "@conychoi/prettier-config": "^1.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "prettier": "@conychoi/prettier-config",
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --no-warn-ignored --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.16.0"
}
